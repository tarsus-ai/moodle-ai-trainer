{{!
    @template mod_tarsuscoach/admin_deletions

    The material the brain still holds although it is gone from Moodle, on
    the administrator's Deletions page, with the button to try again.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * retry - The button that tries the deletions again.
    * rows - The material: resourceid, title (its course), since.

    Example context (json):
    {
        "retry": "",
        "rows": [{"resourceid": "moodle-resource-1", "title": "Course 1 (2)", "since": "25 November 2026"}]
    }
}}
<div class="tarsus-app">
    {{{retry}}}
    <div class="tarsus-table-wrap">
        <table class="tarsus-table">
            <thead>
                <tr>
                    <th>{{#str}}deletions_resource, mod_tarsuscoach{{/str}}</th>
                    <th>{{#str}}deletions_container, mod_tarsuscoach{{/str}}</th>
                    <th>{{#str}}deletions_since, mod_tarsuscoach{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr><td><code>{{resourceid}}</code></td><td>{{title}}</td><td class="tarsus-nowrap">{{since}}</td></tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
</div>
