{{!
    @template mod_tarsuscoach/help

    The help button with its panel of support links and videos. The coach
    script opens the panel and plays a video in place.

    Classes required for JS:
    * tarsus-hidden - toggled to open and close the panel.

    Data attributes required for JS:
    * data-action="help-toggle", data-action="help-close", data-region="help-panel".
    * data-embed, data-title - the video to play in place.

    Context variables required for this template:
    * id - The id of the panel.
    * links - The links: title, url, embed (the video's player address, or empty), video, icon.
    * icons - The icons, as SVG: help, close.

    Example context (json):
    {
        "id": "tarsus-help-1",
        "links": [
            {"title": "Getting started", "url": "https://example.org/help", "embed": "", "video": false, "icon": ""},
            {"title": "Intro video", "url": "https://www.youtube.com/watch?v=abcdefghijk", "embed": "https://www.youtube-nocookie.com/embed/abcdefghijk", "video": true, "icon": ""}
        ],
        "icons": {"help": "", "close": ""}
    }
}}
<div class="tarsus-help">
    <button type="button" class="tarsus-help__button" data-action="help-toggle" aria-expanded="false" aria-controls="{{id}}" title="{{#cleanstr}}help, mod_tarsuscoach{{/cleanstr}}">{{{icons.help}}}<span>{{#cleanstr}}help, mod_tarsuscoach{{/cleanstr}}</span></button>
    <div class="tarsus-help__panel tarsus-hidden" data-region="help-panel" id="{{id}}" role="dialog" aria-label="{{#cleanstr}}help_title, mod_tarsuscoach{{/cleanstr}}">
        <div class="tarsus-help__head">
            <strong>{{#cleanstr}}help_title, mod_tarsuscoach{{/cleanstr}}</strong>
            <button type="button" class="tarsus-help__close" data-action="help-close" aria-label="{{#cleanstr}}learn_image_close, mod_tarsuscoach{{/cleanstr}}">{{{icons.close}}}</button>
        </div>
        <ul class="tarsus-help__list">
            {{#links}}
            <li class="tarsus-help__item{{#video}} tarsus-help__item--video{{/video}}">
                {{{icon}}}
                <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{title}}</a>
                {{#video}}
                <div class="tarsus-help__embed" data-embed="{{embed}}" data-title="{{title}}"></div>
                {{/video}}
            </li>
            {{/links}}
        </ul>
    </div>
</div>
