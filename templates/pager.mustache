{{!
    @template mod_tarsuscoach/pager

    Previous and next page of a list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasprevious - Whether there is a page before this one.
    * previous - The address of the page before.
    * state - Which page of how many, in words.
    * hasnext - Whether there is a page after this one.
    * next - The address of the page after.

    Example context (json):
    {
        "hasprevious": true,
        "previous": "https://example.org/mod/tarsuscoach/materials.php?id=1&page=0",
        "state": "Page 2 of 3",
        "hasnext": true,
        "next": "https://example.org/mod/tarsuscoach/materials.php?id=1&page=2"
    }
}}
<nav class="tarsus-pager" aria-label="{{#cleanstr}}pager, mod_tarsuscoach{{/cleanstr}}">
    {{#hasprevious}}
    <a class="tarsus-btn tarsus-btn--sm" href="{{previous}}">&lsaquo; {{#cleanstr}}pager_previous, mod_tarsuscoach{{/cleanstr}}</a>
    {{/hasprevious}}
    <span class="tarsus-pager__state">{{state}}</span>
    {{#hasnext}}
    <a class="tarsus-btn tarsus-btn--sm" href="{{next}}">{{#cleanstr}}pager_next, mod_tarsuscoach{{/cleanstr}} &rsaquo;</a>
    {{/hasnext}}
</nav>
