{{!
    @template mod_tarsuscoach/plan_usage

    The administrator's panel of the plan and this month's AI credits.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * plan - The plan's name.
    * usage - The usage bar (mod_tarsuscoach/usage_bar): level, label, width.
    * rows - The figures: label and value, both HTML made by the plugin from its language strings.
    * hasitems - Whether the brain reported its usage per service.
    * items - The services that used credits: service, name, credits.

    Example context (json):
    {
        "plan": "Ask",
        "usage": {"level": "ok", "label": "120 of 1,000 AI credits used (12 %)", "width": "12.0"},
        "rows": [{"label": "Billing", "value": "Through your partner"}],
        "hasitems": true,
        "items": [{"service": "ask", "name": "Questions", "credits": "120"}]
    }
}}
<div class="tarsus-panel tarsus-panel--plan">
    <div class="tarsus-plan-head">
        <div>
            <div class="tarsus-eyebrow">{{#cleanstr}}plan_current, mod_tarsuscoach{{/cleanstr}}</div>
            <div class="tarsus-headline">{{plan}}</div>
        </div>
        <div class="tarsus-plan-head__usage">{{#usage}}{{> mod_tarsuscoach/usage_bar}}{{/usage}}</div>
    </div>
    <div class="tarsus-table-wrap">
        <table class="tarsus-table">
            <tbody>
                {{#rows}}
                <tr><th scope="row" style="width:30%">{{{label}}}</th><td>{{{value}}}</td></tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{#hasitems}}
    <details class="tarsus-details">
        <summary>{{#cleanstr}}usage_breakdown, mod_tarsuscoach{{/cleanstr}}</summary>
        <div class="tarsus-table-wrap">
            <table class="tarsus-table">
                <thead>
                    <tr><th>{{#cleanstr}}usage_service, mod_tarsuscoach{{/cleanstr}}</th><th>{{#cleanstr}}usage_name, mod_tarsuscoach{{/cleanstr}}</th><th class="tarsus-num">{{#cleanstr}}status_credits, mod_tarsuscoach{{/cleanstr}}</th></tr>
                </thead>
                <tbody>
                    {{#items}}
                    <tr><td>{{service}}</td><td>{{name}}</td><td class="tarsus-num">{{credits}}</td></tr>
                    {{/items}}
                </tbody>
            </table>
        </div>
    </details>
    {{/hasitems}}
</div>
